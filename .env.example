# Copia este fichero a .env y rellénalo. No lo subas a Git.
# Genera la clave con: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Pon COOKIE_SECURE=true cuando la consola se sirva por HTTPS (proxy TLS).
COOKIE_SECURE=false
# Opcional: crea este administrador en el primer arranque si no hay usuarios (deberá cambiar la contraseña).
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Longitud mínima de contraseña (por defecto 10). Bájala solo si la consola es de uso local.
PASSWORD_MIN_LENGTH=10
PORT=8000
# Opcional, SOLO para una consola en red local: entra sin login como este usuario (existente y activo).
# Cualquiera que llegue a la consola tendrá sus permisos. No lo uses si la consola es accesible desde internet.
ACCESO_LIBRE_USUARIO=
# Opcional: activa «Preguntar a Claude» en los tests (solo admin) y protege la API interna del trabajador
# (scripts/consultas_trabajador.py). Mínimo 32 caracteres; genéralo con: openssl rand -hex 32. Vacío = desactivado.
CONSULTAS_TOKEN=
