{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aif-c01/pregunta.schema.json",
  "title": "Pregunta del banco AIF-C01",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "dominio",
    "tarea",
    "tipo",
    "dificultad",
    "enunciado",
    "opciones",
    "correctas",
    "explicacion",
    "referencia"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(D[0-9]{1,2}|S)-[0-9]{3}$"
    },
    "dominio": {
      "type": "integer",
      "minimum": 1
    },
    "tarea": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "tipo": {
      "enum": [
        "multiple_choice",
        "multiple_response",
        "ordering",
        "matching"
      ]
    },
    "dificultad": {
      "enum": [
        "baja",
        "media",
        "alta"
      ]
    },
    "enunciado": {
      "type": "string",
      "minLength": 20
    },
    "prompts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/elemento"
      }
    },
    "opciones": {
      "type": "array",
      "minItems": 3,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/elemento"
      }
    },
    "correctas": {
      "type": "array",
      "minItems": 1
    },
    "explicacion": {
      "type": "string",
      "minLength": 10
    },
    "distractores": {
      "type": "object",
      "patternProperties": {
        "^[a-j]$": {
          "type": "string",
          "minLength": 5
        }
      },
      "additionalProperties": false
    },
    "referencia": {
      "type": "string",
      "pattern": "^https://docs\\.aws\\.amazon\\.com/|^https://aws\\.amazon\\.com/"
    },
    "objetivo": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "multiple_choice"
          }
        }
      },
      "then": {
        "properties": {
          "opciones": {
            "minItems": 4
          },
          "correctas": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-j]$"
            }
          }
        },
        "not": {
          "required": [
            "prompts"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "multiple_response"
          }
        }
      },
      "then": {
        "properties": {
          "opciones": {
            "minItems": 5
          },
          "correctas": {
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-j]$"
            }
          }
        },
        "not": {
          "required": [
            "prompts"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "ordering"
          }
        }
      },
      "then": {
        "properties": {
          "correctas": {
            "minItems": 3,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-j]$"
            }
          }
        },
        "not": {
          "required": [
            "prompts"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "tipo": {
            "const": "matching"
          }
        }
      },
      "then": {
        "required": [
          "prompts"
        ],
        "properties": {
          "correctas": {
            "minItems": 3,
            "maxItems": 7,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "elemento": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "texto"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-j]$|^[1-9]$"
        },
        "texto": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
